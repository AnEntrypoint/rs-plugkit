package gm:plugkit@0.1.0;

interface env {
  host-cwd: func() -> option<string>;
  host-fs-allow-root: func(path: string) -> bool;
  host-fs-read: func(path: string) -> option<string>;
  host-fs-write: func(path: string, data: string) -> bool;
  host-fs-cas-write: func(path: string, expected: string, data: string) -> u32;
  host-fs-remove: func(path: string) -> bool;
  host-fs-readdir: func(path: string) -> option<string>;
  host-fs-stat: func(path: string) -> option<string>;
  host-fetch: func(url: string, opts: string) -> option<string>;
  host-kv-get: func(ns: string, key: string) -> option<string>;
  host-kv-put: func(ns: string, key: string, val: string) -> u32;
  host-kv-delete: func(ns: string, key: string) -> u32;
  host-kv-query: func(ns: string, query: string) -> option<string>;
  host-vec-search: func(query: string, k: u32) -> option<string>;
  host-vec-embed: func(text: string, out-len: u32) -> tuple<s32, list<f32>>;
  host-exec-js: func(code: string, opts: string) -> option<string>;
  host-log: func(level: u32, msg: string) -> u32;
  host-now-ms: func() -> u64;
  host-env-get: func(key: string) -> option<string>;
  host-random-fill: func(len: u32) -> tuple<u32, list<u8>>;
  host-task-proc: func(action: string, params: string) -> option<string>;
  host-git: func(args: string, cwd: string) -> option<string>;
  host-plugin-call: func(plugin: string, verb: string, body: string) -> option<string>;
  crawl-cdp: func(body: string) -> option<string>;
}

interface guest {
  dispatch-verb: func(verb: string, body: string) -> string;
  plugkit-version: func() -> string;
}

world plugkit-env {
  import env;
  export guest;
}
