// Typed WIT form of the plugkit host `env` ABI (PRD 02).
//
// Each function keeps the name of its raw `env` import. Strings and bytes that
// crossed as (ptr, len) pairs become `string` and `list<u8>`. A packed u64
// return (guest-memory pointer and length) becomes `option<list<u8>>`: `none`
// is the raw 0 (absent or failed), and `some(bytes)` is the host-owned payload.
// The adapter in wasm_dispatch/wit_env.rs maps `some(empty)` of host-fs-read to
// the raw empty-success value 1. A u32 or i32 status keeps its width.
// Sources: wasm_dispatch/host_abi.rs, embed.rs, code_index.rs, pipeline.rs,
// shared_db.rs, vecns.rs and orchestrator/instructions/mod.rs.

package plugkit:env@0.1.0;

interface host {
    host-cwd: func() -> option<list<u8>>;
    host-fs-allow-root: func(path: string) -> u32;
    host-fs-read: func(path: string) -> option<list<u8>>;
    host-fs-write: func(path: string, data: list<u8>) -> u32;
    host-fs-cas-write: func(path: string, expected: list<u8>, data: list<u8>) -> u32;
    host-fs-remove: func(path: string) -> u32;
    host-fs-readdir: func(path: string) -> option<list<u8>>;
    host-fs-stat: func(path: string) -> option<list<u8>>;
    host-fetch: func(url: string, opts: string) -> option<list<u8>>;
    host-kv-get: func(ns: string, key: string) -> option<list<u8>>;
    host-kv-put: func(ns: string, key: string, val: list<u8>) -> u32;
    host-kv-delete: func(ns: string, key: string) -> u32;
    host-kv-query: func(ns: string, query: string) -> option<list<u8>>;
    host-vec-search: func(query: string, k: u32) -> option<list<u8>>;
    host-vec-embed: func(text: string, out-len: u32) -> result<list<f32>, s32>;
    host-exec-js: func(code: string, opts: string) -> option<list<u8>>;
    host-log: func(level: u32, msg: string) -> u32;
    host-now-ms: func() -> u64;
    host-env-get: func(key: string) -> option<list<u8>>;
    host-random-fill: func(len: u32) -> option<list<u8>>;
    host-task-proc: func(action: string, params: string) -> option<list<u8>>;
    host-git: func(args: string, cwd: string) -> option<list<u8>>;
    host-plugin-call: func(plugin: string, verb: string, body: string) -> option<list<u8>>;
    crawl-cdp: func(body: string) -> option<list<u8>>;
}

interface guest {
    dispatch-verb: func(verb: string, body: string) -> string;
    plugkit-version: func() -> string;
}

world plugkit-guest {
    import host;
    export guest;
}
